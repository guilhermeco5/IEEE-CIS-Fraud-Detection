!models/xgboost.joblib
!models/serving_bundle_demo.joblib
models/*.json

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Notebooks - checkpoints
.ipynb_checkpoints/

# Ambiente
.env

# Sistema
.DS_Store
Thumbs.db

